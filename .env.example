# Пример переменных окружения (скопируйте в .env)

# --- Приложение ---
# URL сервера с ИИ-комментариями к чтениям. В production — только https://
VITE_SUMMARIES_URL=https://ispoved.app/summaries.json

# --- Релизы на GitHub (release.js) ---
GITHUB_API_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=ispoved

# --- Публикация в RuStore (если используется) ---
RUSTORE_COMPANY_ID=
RUSTORE_PRIVATE_KEY=

# --- ЮKassa / backend ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
RETURN_URL=https://ispoved.app/donate/success
WEBHOOK_URL=https://ispoved.app/v1/webhook
ADMIN_TOKEN=
